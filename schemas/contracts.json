{
  "contract_version": "0.1.0",
  "timestamp_format": "ISO-8601 UTC",
  "coordinate_unit": "meter",
  "optional_tables": ["trajectories.csv", "path_metrics.csv", "comparison_summary.csv"],
  "artifact_aliases": {
    "ground_truth_congestion.csv": "congestion.csv",
    "observed_congestion.csv": "congestion.csv"
  },
  "tables": {
    "trajectories.csv": [
      "timestamp", "source_time_s", "person_id", "x_m", "y_m", "z_m",
      "speed_m_s", "motion_angle_rad", "facing_angle_rad", "source_dataset"
    ],
    "congestion.csv": [
      "timestamp", "zone_id", "pedestrian_count", "density_per_m2",
      "congestion_level", "observation_state", "source", "confidence",
      "last_observed", "observation_age_s"
    ],
    "observations.csv": [
      "timestamp", "sensor_id", "sensor_type", "x", "y", "heading_deg",
      "visible_zone_ids", "coverage_wkt", "confidence"
    ],
    "robots.csv": [
      "timestamp", "robot_id", "x", "y", "heading_deg", "goal_x", "goal_y"
    ],
    "paths.csv": [
      "timestamp", "robot_id", "path_type", "segment_id", "sequence",
      "x1", "y1", "x2", "y2", "distance_m", "congestion_cost",
      "eta_segment_s"
    ],
    "path_metrics.csv": [
      "timestamp", "robot_id", "path_type", "start_zone_id", "goal_zone_id",
      "path_signature", "planning_cost", "distance_m", "planned_eta_s",
      "actual_simulated_eta_s", "ground_truth_exposure", "unknown_distance_m",
      "stale_distance_m", "segment_count"
    ],
    "comparison_summary.csv": [
      "robot_id", "comparison_count", "different_route_count", "aware_longer_count",
      "actual_eta_better_count", "exposure_better_count", "mean_distance_delta_m",
      "mean_actual_eta_delta_s", "mean_exposure_delta"
    ],
    "replanning_events.csv": [
      "timestamp", "event_id", "robot_id", "trigger_type", "trigger_zone_id",
      "source_sensor_id", "old_path_signature", "new_path_signature", "eta_delta_s",
      "distance_delta_m", "reason"
    ]
  }
}
